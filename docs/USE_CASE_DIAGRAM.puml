@startuml
left to right direction
actor Admin
actor Student
rectangle "College Event Management System" {
  usecase "Create Event" as UC1
  usecase "Update Event" as UC2
  usecase "View Events" as UC3
  usecase "Delete Event" as UC4
  usecase "Register for Event" as UC5
  usecase "Check Registration Status" as UC6
  usecase "Record Attendance" as UC7
